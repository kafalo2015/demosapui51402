{
  "compilerOptions": {

    "target": "ES2022",
    "module": "ESNext",
    "skipLibCheck": true,
    "checkJs": false,
    "allowJs": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "moduleResolution": "Bundler",
    "useDefineForClassFields": false, // CRITIQUE : à laisser à false pour UI5
    "experimentalDecorators": true,
     "types": ["*"],
    
    "rootDir": "./webapp",
    "outDir": "./dist",
  
    "paths": {
      "clf/logistique/chargementquais/*": [
        "./webapp/*"
      ],
      "unit/*": [
        "./webapp/test/unit/*"
      ],
      "integration/*": [
        "./webapp/test/integration/*"
      ]
    },
    "typeRoots": [
      "./node_modules/@types",
      "./node_modules/@sapui5/types",
      "./node_modules/@sapui5"
    ]
  },
  "include": [
    "./webapp/**/*"
    
  ]
}
