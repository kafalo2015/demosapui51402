{
    "_version": "1.65.0",
    "sap.app": {
        "id": "clf.logistique.chargementquais.082025_2",
        "type": "application",
        "i18n": "i18n/i18n.properties",
        "applicationVersion": {
            "version": "1.1.1"
        },
        "title": "{{appTitle}}",
        "description": "{{appDescription}}",
        "resources": "resources.json",
        "sourceTemplate": {
            "id": "@sap/generator-fiori:basic",
            "version": "1.16.3",
            "toolsId": "a010ed0b-a9c9-4fb5-a22d-27573be4e57d"
        },
        "dataSources": {
         
        }
    },
    "sap.ui": {
        "technology": "UI5",
        "icons": {
            "icon": "",
            "favIcon": "",
            "phone": "",
            "phone@2": "",
            "tablet": "",
            "tablet@2": ""
        },
        "deviceTypes": {
            "desktop": true,
            "tablet": true,
            "phone": true
        }
    },
    "sap.ui5": {
        "flexEnabled": true,
        "dependencies": {
            "minUI5Version": "1.132.1",
            "libs": {
                "sap.m": {},
                "sap.ui.core": {},
                "sap.ui.layout": {},
                "sap.f": {},
                "sap.tnt": {}
            }
        },
        "contentDensities": {
            "compact": true,
            "cozy": true
        },
        "config": {
                        "api_env": "dev"
                },
        "models": {
                   
        },
        "resources": {
            "css": [
                {
                    "uri": "css/style.css"
                }
            ]
        },
        "routing": {
            "config": {
                "routerClass": "sap.f.routing.Router",
                "controlAggregation": "pages",
                "controlId": "navcontainermain",
                "transition": "flip",
                "transitionParameters": {},
                "bypassed": {
                "target": "notfound"
                  },
                "type": "View",
                "viewType": "XML",
                "viewPath": "clf.logistique.chargementquais.view",
                "async": true
               
            },
            "routes": [
                {
                    "name": "RouteHome",
                    "pattern": "",
                    "target": [
                        "targetchargementquaiall"
                    ]
                },
                {
                    "name": "RouteChargementList",
                    "pattern": "chargementprevu",
                    "target":  "targetchargementlist"
                    
                },
                {
                    "name": "RouteChargementQuai",
                    "pattern": "chargementquai/{quainumber}",
                    "target":  "targetchargementquaiall"
                    
                    
                },
                 {
                    "name": "RouteChargementStart",
                    "pattern": "chargementstart/{quainumber}",
                    "target":  "targetstartchargementquaiall"
                    
                }
                
                
            ],
            "targets": {
                "targetchargementlist": {
                    "id": "chargementlist",
                    "viewName": "chargementsprevusapp.chargementlist",
                    "level" : 2,
                    "transition": "slide"
                    
                    
                },
                "targetchargementquais": {
                    "id": "AppChargementQuaisIconTabBar",
                    "viewName": "ChargementsQuaisApp.AppChargementQuaisIconTabBar"
                         
                    
					
                },
                "targetchargementquaiall": {
                    "id": "quai_all",
                    "viewName": "ChargementsQuaisApp.quais.quai_all",
                    "parent" :  "targetchargementquais",
                    "controlId": "navContainerQuais", 
                    "controlAggregation": "pages",    
                    "clearControlAggregation": true,
                    "transition" : "flip"
                    

                    
                },
                     "targetstartchargementquaiall": {
                    "id": "ChargementStartQuaiall",
                    "viewName": "ChargementsQuaisApp.startchargement.ChargementStart",
                    "parent" :  "targetchargementquais",
                    "controlId": "navContainerQuais",
                    "controlAggregation": "pages",
                    "clearControlAggregation": true
                    
                    
                },
                "notfound": {
                    "id": "notfound",
                    "name": "notfound",
                     "path": "clf.logistique.chargementquais.view.error",
                     "transition": "show"
                 }
            }
        },
        "rootView": {
            "viewName": "clf.logistique.chargementquais.view.main.MainSideNavigation",       
            "type": "XML",
            "id": "App",
            "async": true
        }
    }
}