{
    "_version": "2.0.0",
    "sap.app": {
        "id": "chargementquais",
        "type": "application",
        "i18n": "i18n/i18n.properties",
        "applicationVersion": {
            "version": "1.1.1"
        },
        "sourceLanguage": "fr",
        "title": "{{appTitle}}",
        "description": "{{appDescription}}",
        "resources": "resources.json",
        "sourceTemplate": {
            "id": "@sap/generator-fiori:basic",
            "version": "1.16.3",
            "toolsId": "a010ed0b-a9c9-4fb5-a22d-27573be4e57d"
        },
        "dataSources": {
         
        }
    },
    "sap.ui": {
        "technology": "UI5",
        "icons": {
            "icon": "",
            "favIcon": "",
            "phone": "",
            "phone@2": "",
            "tablet": "",
            "tablet@2": ""
        },
        "deviceTypes": {
            "desktop": true,
            "tablet": true,
            "phone": true
        }
    },
    "sap.ui5": {
        "flexEnabled": true,
        "dependencies": {
            "minUI5Version": "1.120.0",
            "libs": {
                "sap.m": {},
                "sap.ui.core": {},
                "sap.ui.layout": {},
                "sap.f": {},
                "sap.tnt": {}
            }
        },
        "contentDensities": {
            "compact": false,
            "cozy": true
        },
        "config": {
                    "api_env": "dev",
                    "sap/base/Log": {
                                     "level": "INFO"
                                    }
                },
        "models": {
            "i18n": {
                 "type": "sap.ui.model.resource.ResourceModel",
                "settings": {
                           "bundleUrl": "i18n/i18n.properties",
                           "supportedLocales": ["fr", "en"],
                           "fallbackLocale": "fr"
                           
                            }
             },
           "chargementModelJson": {
                    "type": "sap.ui.model.json.JSONModel",
                    "preload": true
           },
           "chargementsPrevusListModel": {
                    "type": "sap.ui.model.json.JSONModel",
                    "preload": true
           },
            "validationMsgChargementQuaiModelJSON": {
                    "type": "sap.ui.model.json.JSONModel",
                    "preload": true
           },
            "ChargementStartModel": {
                    "type": "sap.ui.model.json.JSONModel",
                    "preload": true
           },
            "device": {
                "type": "sap.ui.model.json.JSONModel",
                "preload": true,
                "settings": {},
                "dataSource": "" 
            }
                   
        },
        "resources": {
            "css": [
                {
                    "uri": "css/style.css"
                }
            ]
        },
        "routing": {
            "config": {
                "routerClass": "sap.f.routing.Router",
                "controlAggregation": "pages",
                "controlId": "navcontainermain",
                "transition": "show",
                "transitionParameters": {},
                "bypassed": {
                "target": "notfound"
                  },
                "type": "View",
                "viewType": "XML",
                "viewPath": "clf.logistique.chargementquais.view"
                
               
            },
            "routes": [
            
                {
                    "name": "RouteChargementList",
                    "pattern": "chargementprevu",
                    "target":  "targetchargementlist"
                    
                },
                {
                    "name": "RouteChargementQuai",
                    "pattern": "chargementquai/{quainumber}",
                    "target":  "targetchargementquaiall"
                    
                    
                },
                   
                  
                 {
                    "name": "RouteChargementStart",
                    "pattern": "chargementstart/{quainumber}",
                    "target":  "targetstartchargementquaiall"
                    
                },
                    {
                    "name": "RouteHome",
                    "pattern": "",
                    "target": [
                        "targetchargementlist"
                    ]
                },
                {
                    "name": "notFound",
                    "pattern": ":all*:",
                    "target": "targetNotFound"
                    }
                
                
            ],
            "targets": {
                "targetchargementlist": {
                    "id": "chargementlist",
                    "viewName": "chargementsprevusapp.chargementlist",
                    "level" : 2,
                    "transition": "slide"
                    
                    
                },
                "targetchargementquais": {
                    "id": "AppChargementQuaisIconTabBar",
                    "viewName": "ChargementsQuaisApp.AppChargementQuaisIconTabBar"
                   
					
                },
                "targetchargementquaiall": {
                    "id": "quai_all",
                    "viewName": "ChargementsQuaisApp.quais.quai_all",
                    "parent" :  "targetchargementquais",
                    "controlId": "animWrapper", 
                    "controlAggregation": "items",    
                    "clearControlAggregation": true,
                    "transition" : "show"
                },
             
                     "targetstartchargementquaiall": {
                    "id": "ChargementStartQuaiall",
                    "viewName": "ChargementsQuaisApp.startchargement.ChargementStart",
                    "parent" :  "targetchargementquais",
                    "controlId": "animWrapper",
                    "controlAggregation": "items",
                    "clearControlAggregation": true
                    
                    
                },
                "targetNotFound": {
                    "id": "notfound",
                    "viewName": "error.notfound",
                    "transition": "show"
                 }
            }
        },
        "rootView": {
            "viewName": "clf.logistique.chargementquais.view.main.MainSideNavigation",       
            "type": "XML",
            "id": "App"
            
        }
    }
}