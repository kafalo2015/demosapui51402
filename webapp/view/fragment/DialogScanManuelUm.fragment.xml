<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core"
	 xmlns:l="sap.ui.layout"                                   >
 
<Dialog title="Scan UM " showHeader= "true" contentWidth = "40%" contentHeight = "20%" resizable ="true" draggable="true" initialFocus="InputUmScan">
	
		 <l:BlockLayout id="blockLayoutScanUM" class="sapUiSmallMargin">
		<l:BlockLayoutRow >
			<l:BlockLayoutCell
			   title=""
			   titleAlignment = "Begin"
			   width = "75"
			   class="sapUiContentPadding sapUiNoMarginBegin sapUiNoMarginBottom"
			   backgroundColorSet="ColorSet1"
			   backgroundColorShade="ShadeA">
	
	<FlexBox
				     direction="Column"
				     justifyContent="Start"
				     alignItems="Center">

	<Label id= "LabelScanUm" class="sapUiTinyMarginEnd" text="Veuillez saisir ou scanner UM"  design="Bold" />
    <Input
			id="InputUmScan"
			value=   "{ChargementUmModel>/codum}" 
			placeholder="Scannez un UM"
			submit="onSubmitUm"
			showSuggestion="false"
			showValueHelp="false">
			
		</Input>

			<MessageStrip id = "messageStripInformationScanManuel"
				text="{notificationsQuaisModel>notifs/notifsuccess_scanmanuelum/msg_txt}"
				type="Success"
				showIcon="true"
				visible = "{notificationsQuaisModel>notifs/notifsuccess_scanmanuelum/visible}"
				class="sapUiNoMarginBottom sapUiNoMarginBegin">
	</MessageStrip>  

		 <MessageStrip id = "messageStripErrorScanManuel"
				text="{notificationsQuaisModel>notifs/notiferror_scanmanuelum/msg_txt}"
				type="Error"
				showIcon="true"
				visible = "{notificationsQuaisModel>notifs/notiferror_scanmanuelum/visible}"
				class="sapUiNoMarginBottom">
			</MessageStrip>
	</FlexBox>

				</l:BlockLayoutCell>
</l:BlockLayoutRow>
</l:BlockLayout>	
<!--<beginButton>
		<Button  id="ScanUMAccept" type="Accept" text="Charger UM"
				press=".onValidScanUm" />
	</beginButton>			-->		
	<endButton>		    
		<Button id="ScanUMReject"  type="Reject" text="Fermer"
				press=".onDialogValidScanUMClose" />
	</endButton>
</Dialog>

</core:FragmentDefinition>