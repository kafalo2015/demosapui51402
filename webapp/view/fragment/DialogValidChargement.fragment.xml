<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core">
	
<Dialog title="Validation" 	contentWidth = "50%"
		contentHeight = "25%" resizable ="true">
 
	 <Panel  headerText ="" id = "PanelValidationChargement" stickyHeader="true" height="100%" width = "100%">
	      <content>  
				<List   headerText="" mode="" items="{ path : 'validationMsgChargementQuaiModelJSON>tValidationMsg'}"
						growing="false"
						growingThreshold="1"
						growingScrollToLoad="false">
					<CustomListItem>
					<FlexBox type = "Horizontal">
						<!--    INFOS SUPPLEMENTAIRES DANS LE TEXTE DU MSG_STRIP POUR DES TESTS LOT8/LOT9 VALDATION DES QUAIS
						<MessageStrip 
							text="{notificationsQuaisModel>validationtxt} Check id : {notificationsQuaisModel>checkid} Numéro d'UM : {notificationsQuaisModel>codum} Numéro de check : {notificationsQuaisModel>checknumber}"
							type="Warning"
							showIcon="true"
							visible = "true"
							class="sapUiNoMarginBottom sapUiNoMarginBegin">
						</MessageStrip>	-->
						<MessageStrip 
							text="DATE({validationMsgChargementQuaiModelJSON>errdt}) HEURE({validationMsgChargementQuaiModelJSON>errzt}) USER({validationMsgChargementQuaiModelJSON>aenam}) UM({validationMsgChargementQuaiModelJSON>exidv}) : {validationMsgChargementQuaiModelJSON>errtx}"
							type="Warning"
							showIcon="true"
							visible = "true"
							class="sapUiNoMarginBottom sapUiNoMarginBegin">
						</MessageStrip>
						<Button
					id="ButtonOK"
					class="sapUiTinyMarginBeginEnd"
					icon="sap-icon://accept"
					type="Default"
					badgeStyle="Attention"
					text="OK"
					press=".onConfirmValidationMsgChargement">
					 </Button>
						<Button
					id="ButtonReject"
					visible = "{= %{validationMsgChargementQuaiModelJSON>msgType} === 'C'?true:false}"
					class="sapUiTinyMarginBeginEnd"
					icon="sap-icon://decline"
					type="Default"
					badgeStyle="Attention"
					text="Refuser"
					press=".onConfirmValidationMsgChargement"
					>
				       </Button>
                </FlexBox>
					</CustomListItem>
	            </List>
				
		  </content>		
     </Panel>
	 <beginButton>
    <Button text = "Fermer" press=".onValidationClose"> </Button>
	</beginButton>	 
 
</Dialog>

</core:FragmentDefinition>