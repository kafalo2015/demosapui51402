<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core">
 
<Dialog title="Motifs de non chargement" 	contentWidth = "70%" contentHeight = "50%" resizable ="true">
		    <Table id="tableMotifsNcharg" class="sapSmallMargin" width="auto" noDataText="L'ensemble des postes ont été chargés, vous pouvez terminer le chargement" sticky="{'sap.m.Sticky.ColumnHeaders'}" enableBusyIndicator = "true"
		items="{
				path : 'finChargementQuaiModelJSON>/tMotifNocharg'			
			}">
		
		<columns>
		     <Column  hAlign="Center" width="20%">  <Text text="Motif"/>                </Column>
			 <Column  hAlign="Center" width="5%">   <Text text="Code Motif"/>           </Column>
			 <Column  hAlign="Center" width="10%">  <Text text="Lib. Motif"/>           </Column>
			 <Column  hAlign="Center" width="10%">  <Text text="Transport"/>            </Column> 
		     <Column  hAlign="Center" width="10%">  <Text text="Livraison"/>            </Column>
			 <Column  hAlign="Center" width="10%">  <Text text="Poste liv."/>           </Column>
			 <Column  hAlign="Center" width="5%">   <Text text="Type UM"/>              </Column>
			 <Column  hAlign="Center" width="10%">  <Text text="N° Cde"/>               </Column>
			 <Column  hAlign="Center" width="10%">  <Text text="Pst Cde"/>              </Column>
			 <Column  hAlign="Center" width="10%">  <Text text="Article"/>              </Column>
		</columns>
		<items>
			<ColumnListItem type="Inactive" press=".onPress">
				<cells>
				<!-- TODO ANO 16/03/2026 Le state n'est pas réinitialisé lorsqu'on rouvre la boîte de dialogue après l'avoir fermé. Il faut créer un viewModel dédié ou étendre le modèle finChargement-->
					<ComboBox
						id = "MotifNchCmbBox"		
						showSecondaryValues= "true"
						change = ".onMotifNchCmbBoxChange"
						selectionChange = ".onMotifNchCmbBoxSelectionChange"
						valueState="Error"            
						items="{
							path: 'finChargementQuaiModelJSON>/tCodelib',
							sorter: { path: 'zcdlib' }
					}">
						<core:ListItem key="{finChargementQuaiModelJSON>zcdlib}" text="{finChargementQuaiModelJSON>zlib25}" additionalText = "{finChargementQuaiModelJSON>zcdlib}"/>
					</ComboBox>
						<ObjectIdentifier title="{finChargementQuaiModelJSON>codmot}" />
						<ObjectIdentifier title="{finChargementQuaiModelJSON>libmot}" />
						<ObjectIdentifier title="{finChargementQuaiModelJSON>numtra}" />  
						<ObjectIdentifier title="{finChargementQuaiModelJSON>numliv}" />
						<ObjectIdentifier title="{finChargementQuaiModelJSON>pstliv}" />
						<ObjectIdentifier title="{finChargementQuaiModelJSON>typum}" />
						<ObjectIdentifier title="{finChargementQuaiModelJSON>numcde}" />
						<ObjectIdentifier title="{finChargementQuaiModelJSON>pstcde}" />
						<ObjectIdentifier title="{finChargementQuaiModelJSON>codart}" />
				</cells>
			</ColumnListItem>
		</items>
	</Table>
	<beginButton>
		<Button  id="MotifsnchAccept" type="Accept" text="Terminer le chargement"
				press=".onconfirmMotifsNch" />
	</beginButton>					
	<endButton>		    
		<Button id="MotifsnchReject"  type="Reject" text="Refuser"
				press=".onDialogMotifsClose" />
	</endButton>						
</Dialog>

</core:FragmentDefinition>