<mvc:View controllerName="clf.logistique.chargementquais.controller.chargementsprevusapp.chargementlist"
    xmlns:f="sap.ui.layout.form"
    xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	xmlns:f2="sap.f"
	xmlns:card="sap.f.cards"	
    xmlns="sap.m">
     	
		<f2:Card class="sapUiMediumMargin" width="800px" core:require="{
                    Unit: 'sap/ui/model/type/Unit'
                }">
		<f2:header>
			<card:Header title="Indicateurs" subtitle="" />
		</f2:header>
		<f2:content>
        	<FlexBox
				direction="Row"
				justifyContent="SpaceBetween"
				alignItems="Center"		
				>
			   <ObjectAttribute text="{i18n>ObjectAttributeTonnagePrevu}"  class="sapUiTinyMarginEnd sapUiTinyMarginBegin"/>
				<ObjectNumber
				class="sapUiTinyMarginEnd"
				number="{= Math.round(%{chargementsPrevusListModel>/results/poidsprevucumul})}"
				inverted="true"
				unit="TONNE"
				state="Information" />
                
				<ObjectAttribute text="{i18n>ObjectAttributeTonnageCharg}"  class="sapUiTinyMarginEnd"/>                            
				<ObjectNumber
				class="sapUiTinyMarginEnd"
				number="{= Math.round(%{chargementsPrevusListModel>/results/poidschargcumul})}"
				inverted="true"
				unit="TONNE"
				state="Success" />
                <ObjectAttribute text="{i18n>ObjectAttributeTonnageACharg}"  class="sapUiTinyMarginEnd"/>
				<ObjectNumber
				class="sapUiTinyMarginEnd"
				number="{= Math.round(%{chargementsPrevusListModel>/results/poidsrestantcumul})}"
				inverted="true"
				unit="TONNE"
				state="Error" />

				</FlexBox>
		</f2:content>
	</f2:Card>
<ScrollContainer height='72%' vertical='true'>

      <Table
		id="chargementTable"
		class="sapUiResponsiveMargin"
		width="auto"
		items="{
				path : 'chargementsPrevusListModel>/results/chargementlist'			
			}">
		<columns>
			<Column  hAlign="Begin" width="12%">  <Text text="TRANSPORT"/>                 </Column>
			<Column  hAlign="Begin" width="13%">  <Text text="TRANSPORTEUR" />             </Column>
			<Column  hAlign="Begin" width="13%">  <Text text="HEURE PREVUE CHARGEMENT" />  </Column>
			<Column  hAlign="Begin" width="13%">  <Text text="HEURE ARRIVEE CAMION" />     </Column>
			<Column  hAlign="Begin" width="13%">  <Text text="HEURE DEBUT CHARGEMENT" />   </Column>
			<Column  hAlign="Begin" width="8%">   <Text text="FAUX CAMION" />              </Column>
			<Column  hAlign="Begin" width="8%">   <Text text="UM CHARGE" />                </Column>
			<!--<Column  hAlign="Begin" width="8%">   <Text text="TONNAGE PREVU" />            </Column>-->
			<Column  hAlign="Begin" width="7%">   <Text text="QUAI" />                     </Column>
			<Column  hAlign="Begin" width="1%">   <Text text="" />                         </Column>
		</columns>
		<items>
			<ColumnListItem
				type="Inactive"
				highlight="{= %{chargementsPrevusListModel>retard} === 'X' ? 'Error' : 'None' }"
				press=".onPress">
				<cells>
				    <ObjectIdentifier title="{chargementsPrevusListModel>numtra}" />
					<ObjectIdentifier title="{chargementsPrevusListModel>nomtra}" />			
					<Text text="{= 	%{chargementsPrevusListModel>heupre}.substring(0,5)}" />
					<Text text="{= 	%{chargementsPrevusListModel>heuarr}.substring(0,5)}" />
					<Text text="{= 	%{chargementsPrevusListModel>heudch}.substring(0,5)}" />
					<Text text="{chargementsPrevusListModel>fcam1}	" />	
					<Text text="{chargementsPrevusListModel>nbumch}/{chargementsPrevusListModel>nbumac}" />	
					<!--<Text text="{chargementsPrevusListModel>poidsprevu}" />	-->
					<Link text="{chargementsPrevusListModel>quai}"  press=".handleLinkPress" />				
				</cells>
			</ColumnListItem>
		</items>
	</Table>
	</ScrollContainer>
    </mvc:View>
