<mvc:View controllerName="clf.logistique.chargementquais.controller.ChargementsQuaisApp.ChargementQuais"
    xmlns:mvc="sap.ui.core.mvc"
	xmlns:l="sap.ui.layout"
    xmlns:form="sap.ui.layout.form"
	xmlns:si="sap.suite.ui.commons.statusindicator"
    xmlns="sap.m">

	<l:BlockLayout id="blockLayout" class="sapUiSmallMargin">
		<l:BlockLayoutRow >
			<l:BlockLayoutCell
			   title="Quai: {chargementModelJson>/results/5/quai} Transport: {chargementModelJson>/results/5/numtransport}"
			   titleAlignment = "Begin"
			   width = "75"
			   class="sapUiContentPadding sapUiNoMarginBegin sapUiNoMarginBottom"
			   backgroundColorSet="ColorSet9"
			   backgroundColorShade="ShadeE">
					<FlexBox
				     direction="Row"
				     justifyContent="Start"
				     alignItems="Center">
					 <items>
                        <Label  id= "LabelChargeur" class="sapUiTinyMarginEnd" text="Chargeur"  design="Bold"  />
						<Text id="Chargeur_txt"  class="sapUiTinyMarginEnd" text="{chargementModelJson>/results/5/zpcfName1}"/>
						 <Label id= "LabelTransporteur" class="sapUiTinyMarginEnd" text="Transporteur"  design="Bold" />
				         <Text id= "NumTransporteur_txt" class="sapUiTinyMarginEnd" text="{chargementModelJson>/results/5/transporteur}"/>
				         <Label id= "LabelFauxCam" text="Faux Camion" class="sapUiTinyMarginEnd" design="Bold" /> 
				        <Text id="faux_camion_txt" class="sapUiTinyMarginEnd" text="{chargementModelJson>/results/5/fauxcamion}"/>
						 </items>
				</FlexBox> 
				 	<FlexBox
				     direction="Row"
				     justifyContent="Start"
				     alignItems="Center">
					 <items>
						<Label id= "LabelConsignes" text="Consignes chargement" class="sapUiTinyMarginEnd" design="Bold" /> 
				        <Text id="consignes_txt" class="sapUiTinyMarginEnd" text="{chargementModelJson>/results/5/text1} {chargementModelJson>/results/5/text2} {chargementModelJson>/results/5/text3} {chargementModelJson>/results/5/text4}"/>
					</items>
				</FlexBox>
			</l:BlockLayoutCell>
			<l:BlockLayoutCell
			   title=""
			   width = "25"
			   backgroundColorSet="ColorSet9"
			   backgroundColorShade="ShadeD">
					 <ProgressIndicator
						id="LoadingIndicator"
						class="sapUiSmallMarginBottom"
						percentValue="{= %{chargementModelJson>/results/5/umCharg} === 0?0:%{chargementModelJson>/results/5/umCharg} / %{chargementModelJson>/results/5/umNb} * 100 }"
						displayValue="{= %{chargementModelJson>/results/5/umCharg} === 0?0:Math.round(%{chargementModelJson>/results/5/umCharg} / %{chargementModelJson>/results/5/umNb} * 100 )}%"
						state="Information"
						displayOnly="true"
						displayAnimation= "true" />
				     <FlexBox
						direction="Row"
						justifyContent="Center"
						alignItems="Center">
						<items>
						<Label id= "LabelUmcharg" text="Chargées" class="sapUiTinyMarginEnd"  design="Bold" /> 
						<Text id= "InputUmCharg" class="sapUiTinyMarginEnd" text="{chargementModelJson>/results/5/umCharg}"  />
						<Label id= "LabelUmNb" text="Nb Um" class="sapUiTinyMarginEnd" design="Bold" /> 
						<Text id= "InputUmNb" text="{chargementModelJson>/results/5/umNb}"  />
						</items>
				    </FlexBox>	
			</l:BlockLayoutCell>
		</l:BlockLayoutRow>
	</l:BlockLayout> 

<ScrollContainer height='250px' vertical='true'>
	 <Table id="TablePostesNonCharges_quai13" class="sapSmallMargin"  width="auto"  headerText="Postes restants"
		items="{
				path : 'chargementModelJson>/results/5/tPosteNocharge'	  		
			}">
	     <columns>
		    <Column hAlign="Begin" width="10%"> <Text text="Livraison" /> </Column>
			<Column hAlign="Begin" width="6%"> <Text text="Poste Livr."/> </Column>
			<Column hAlign="Begin" width="12%"> <Text text="Article" /> </Column>	
			<Column hAlign="Begin" width="10%"> <Text text="Type UM" /> </Column>
			<Column hAlign="Begin" width="10%"> <Text text="Commande" /> </Column>	
			<Column hAlign="Begin" width="22%"> <Text text="Client" /> </Column>	
			<Column hAlign="Begin" width="7%"> <Text text="UMs chargés" /> </Column>	
			<Column hAlign="Begin" width="7%"> <Text text="UMs à charger" /></Column>
			<Column hAlign="Begin" width="7%"> <Text text="Statut faux camion" /></Column>	
		    <Column hAlign="Begin" width="9%"> <Text text="FauxCam" /></Column>
			<Column hAlign="Begin" width="6%"> <Text text="Stock" /></Column>
			<Column hAlign="Begin" width="1%"> <Text text="" /></Column>
		 	
		</columns>
		<items>
			<ColumnListItem type="Inactive" press=".onPress">
				<cells>
				    <ObjectIdentifier  title="{chargementModelJson>numliv}"  />
				    <ObjectIdentifier title="{chargementModelJson>pstliv}" />
					<Text text="{chargementModelJson>codart}" />
					<ObjectIdentifier title="{chargementModelJson>labelTypum}" />
					<Text text="{chargementModelJson>numcde}" />
					<Text text="{chargementModelJson>name1}" />
					<Text text="{chargementModelJson>nbumch}" />
					<Text text="{chargementModelJson>nbumac}" />
					<Text text="{chargementModelJson>nbUmFaucam}" />
					<Button text="FauxCam" 	press=".onSelectDialogUmFauxCam"/>
					<Button text="Stock" 	press=".onSelectDialogUmStockPress"/>
				</cells>
			</ColumnListItem>
		</items>
	</Table>
</ScrollContainer>
<ScrollContainer height='250px' vertical='true'>
	 <Table id="tableChargementUM_quai13" class="sapSmallMargin" width="auto" headerText="UMs Chargées"
		items="{
				path : 'chargementModelJson>/results/5/tChargItem'			
			}">
		<columns>
		   <Column hAlign="Begin" width="17%"> <Text text="Um" />          </Column>
			<Column hAlign="Begin" width="10%">  <Text text="Livraison" />  </Column>
			<Column hAlign="Begin" width="6%">  <Text text="Poste" />       </Column>
			<Column hAlign="Begin" width="12%">  <Text text="Article" />    </Column>
			<Column hAlign="Begin" width="6%">  <Text text="Qtite" />       </Column>
			<Column hAlign="Begin" width="49%"> <Text text="" />            </Column>
		</columns>
		<items>
			<ColumnListItem
				type="Inactive"
				press=".onPress">
				<cells>
				    <ObjectIdentifier title="{chargementModelJson>um}" />
				    <ObjectIdentifier title="{chargementModelJson>vbeln}" />
					<ObjectIdentifier title="{chargementModelJson>poste}" />
					<Text text="{chargementModelJson>article}" />
					<Text text="{chargementModelJson>qtite}" />
				</cells>
			</ColumnListItem>
		</items>
	</Table>
	</ScrollContainer>


    <MessageStrip id = "messageStripErrorV2"
				text="{notificationsQuaisModel>/quais/5/notiferror/msg_text}"
				type="Error"
				showIcon="true"
				visible = "{notificationsQuaisModel>/quais/5/notiferror/visible}"
				class="sapUiNoMarginBottom">
			</MessageStrip>

		    <MessageStrip id = "messageStripWarningV2"
				text="{notificationsQuaisModel>/quais/5/notifwarning/msg_text}"
				type="Warning"
				showIcon="true"
				visible = "{notificationsQuaisModel>/quais/5/notifwarning/visible}"
				class="sapUiNoMarginBottom">
			</MessageStrip>
			<MessageStrip id = "messageStripInformationV2"
				text="{notificationsQuaisModel>/quais/5/notifsuccess/msg_text}"
				type="Success"
				showIcon="true"
				visible = "{notificationsQuaisModel>/quais/5/notifsuccess/visible}"
				class="sapUiNoMarginBottom sapUiNoMarginBegin">
			</MessageStrip>

		<MessageStrip id = "messageStripError"
				text=""
				type="Error"
				showIcon="true"
				visible = "false"
				class="sapUiNoMarginBottom">
			</MessageStrip>
			 <MessageStrip id = "messageStripWarning"
				text=""
				type="Warning"
				showIcon="true"
				visible = "false"
				class="sapUiNoMarginBottom">
			</MessageStrip>
			<MessageStrip id = "messageStripInformation"
				text=""
				type="Success"
				showIcon="true"
				visible = "false"
				class="sapUiNoMarginBottom sapUiNoMarginBegin">
			</MessageStrip>
    </mvc:View>
