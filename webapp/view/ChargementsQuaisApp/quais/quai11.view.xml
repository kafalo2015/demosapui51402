<mvc:View controllerName="clf.logistique.chargementquais.controller.ChargementsQuaisApp.ChargementQuais"
    xmlns:l="sap.ui.layout"
    xmlns:form="sap.ui.layout.form"
    xmlns:mvc="sap.ui.core.mvc"
	xmlns:si="sap.suite.ui.commons.statusindicator"
    xmlns="sap.m">

     <l:BlockLayout id="blockLayout" class="sapUiSmallMargin">
		<l:BlockLayoutRow >
			<l:BlockLayoutCell
			   title="Quai: {chargementModelJson>/results/3/quai} Transport: {chargementModelJson>/results/3/numtransport}"
			   titleAlignment = "Begin"
			   width = "75"
			   class="sapUiContentPadding sapUiNoMarginBegin sapUiNoMarginBottom"
			   backgroundColorSet="{notificationsQuaisModel>/quais/3/header/backgroundcolorset}"
			   backgroundColorShade="{notificationsQuaisModel>/quais/3/header/backgroundcolorshade}">
					<FlexBox
				     direction="Row"
				     justifyContent="Start"
				     alignItems="Center">
					 <items>
                        <Label  id= "LabelChargeur" class="sapUiTinyMarginEnd" text="Chargeur"  design="Bold"  />
						<Text id="Chargeur_txt"  class="sapUiTinyMarginEnd" text="{chargementModelJson>/results/3/zpcfName1}"/>
						 <Label id= "LabelTransporteur" class="sapUiTinyMarginEnd" text="Transporteur"  design="Bold" />
				         <Text id= "NumTransporteur_txt" class="sapUiTinyMarginEnd" text="{chargementModelJson>/results/3/transporteur}"/>
				         <Label id= "LabelFauxCam" text="Faux Camion" class="sapUiTinyMarginEnd" design="Bold" /> 
				        <Text id="faux_camion_txt" class="sapUiTinyMarginEnd" text="{chargementModelJson>/results/3/fauxcamion}"/>
						 </items>
				</FlexBox> 
				 	<FlexBox
				     direction="Row"
				     justifyContent="Start"
				     alignItems="Center">
					 <items>
						<Label id= "LabelConsignes" text="Consignes chargement" class="sapUiTinyMarginEnd" design="Bold" /> 
				        <Text id="consignes_txt" class="sapUiTinyMarginEnd" text="{chargementModelJson>/results/3/text1} {chargementModelJson>/results/3/text2} {chargementModelJson>/results/3/text3} {chargementModelJson>/results/3/text4}"/>
					</items>
				</FlexBox>
			</l:BlockLayoutCell>
			<l:BlockLayoutCell
			   title=""
			   width = "25"
			   backgroundColorSet="ColorSet9"
			   backgroundColorShade="ShadeD">
					 <ProgressIndicator
						id="LoadingIndicator"
						class="sapUiSmallMarginBottom"
						percentValue="{= %{chargementModelJson>/results/3/umCharg} === 0?0:%{chargementModelJson>/results/3/umCharg} / %{chargementModelJson>/results/3/umNb} * 100 }"
						displayValue="{= %{chargementModelJson>/results/3/umCharg} === 0?0:Math.round(%{chargementModelJson>/results/3/umCharg} / %{chargementModelJson>/results/3/umNb} * 100 )}%"
						state="Information"
						displayOnly="true"
						displayAnimation= "true" />
				     <FlexBox
						direction="Row"
						justifyContent="Center"
						alignItems="Center">
						<items>
						<Label id= "LabelUmcharg" text="Chargées" class="sapUiTinyMarginEnd"  design="Bold" /> 
						<Text id= "InputUmCharg" class="sapUiTinyMarginEnd" text="{chargementModelJson>/results/3/umCharg}"  />
						<Label id= "LabelUmNb" text="Nb Um" class="sapUiTinyMarginEnd" design="Bold" /> 
						<Text id= "InputUmNb" text="{chargementModelJson>/results/3/umNb}"  />
						</items>
				    </FlexBox>	
			</l:BlockLayoutCell>
		</l:BlockLayoutRow>
	</l:BlockLayout> 

	<ScrollContainer height='250px' vertical='true'>
	  <Table id="TablePostesNonCharges_quai10"  class="sapSmallMargin" backgroundDesign = "Solid"  width="auto" headerText="Postes restants" enableBusyIndicator = "true" 
		items="{
				path : 'chargementModelJson>/results/3/tPosteNocharge'	  		
			}">
		
	    <columns>
            <Column hAlign="Begin" width="10%"> <Text text="Livraison" /> </Column>
			<Column hAlign="Begin" width="6%"> <Text text="Poste Livr."/> </Column>
			<Column hAlign="Begin" width="12%"> <Text text="Article" /> </Column>	
			<Column hAlign="Begin" width="10%"> <Text text="Type UM" /> </Column>
			<Column hAlign="Begin" width="10%"> <Text text="Commande" /> </Column>	
			<Column hAlign="Begin" width="22%"> <Text text="Client" /> </Column>	
			<Column hAlign="Begin" width="7%"> <Text text="UMs chargés" /> </Column>	
			<Column hAlign="Begin" width="7%"> <Text text="UMs à charger" /></Column>
			<Column hAlign="Begin" width="7%"> <Text text="Statut faux camion" /></Column>	
		    <Column hAlign="Begin" width="9%"> <Text text="FauxCam" /></Column>
			<Column hAlign="Begin" width="6%"> <Text text="Stock" /></Column>
			<Column hAlign="Begin" width="1%"> <Text text="" /></Column>
			
		
		</columns>
		<items>
			<ColumnListItem type="Inactive" press=".onPress">
				<cells>
				    <ObjectIdentifier  title="{chargementModelJson>numliv}"  />
				    <ObjectIdentifier title="{chargementModelJson>pstliv}" />
					<Text text="{chargementModelJson>codart}" />
					<ObjectIdentifier title="{chargementModelJson>labelTypum}" />
					<Text text="{chargementModelJson>numcde}" />
					<Text text="{chargementModelJson>name1}" />
					<Text text="{chargementModelJson>nbumch}" />
					<Text text="{chargementModelJson>nbumac}" />
					<Text text="{chargementModelJson>nbUmFaucam}" />
				    <Button text="FauxCam" 	press=".onSelectDialogUmFauxCam"/>
					<Button text="Stock" 	press=".onSelectDialogUmStockPress"/>
				</cells>
			</ColumnListItem>
		</items>
	</Table>	
		</ScrollContainer>
			<ScrollContainer height='250px' vertical='true'>
	    <Table id="tableChargementUM_quai10" class="sapSmallMargin" width="auto" headerText="UMs Chargées" enableBusyIndicator = "true"
		items="{
				path : 'chargementModelJson>/results/3/tChargItem'			
			}">
				<headerToolbar>
					<OverflowToolbar id="otbSubheader">
					<Text text="UMs Chargées" />
						<ToolbarSpacer/>
						<Button id="ScanManuelQuai11" text="Scan Manuel UM" type="Transparent" press=".onScanManuelUm" icon= "sap-icon://bar-code"/>
					</OverflowToolbar>
				</headerToolbar>	
		
		<columns>
		   <Column hAlign="Begin" width="17%"> <Text text="Um" />          </Column>
			<Column hAlign="Begin" width="10%">  <Text text="Livraison" />  </Column>
			<Column hAlign="Begin" width="6%">  <Text text="Poste" />       </Column>
			<Column hAlign="Begin" width="12%">  <Text text="Article" />    </Column>
			<Column hAlign="Begin" width="6%">  <Text text="Qtite" />       </Column>
			<Column hAlign="Begin" width="49%"> <Text text="" />            </Column>
		</columns>
		<items>
			<ColumnListItem type="Inactive" press=".onPress">
				<cells>
				   <ObjectIdentifier  title="{chargementModelJson>um}"  />
				    <ObjectIdentifier title="{chargementModelJson>vbeln}" />
					<ObjectIdentifier title="{chargementModelJson>poste}" />						
					<Text text="{chargementModelJson>article}" />
					<Text text="{chargementModelJson>qtite}" />
				</cells>
			</ColumnListItem>
		</items>
	</Table>
	</ScrollContainer>


	<Button id="FinChargQuai11" text="Fin Chargement" type= "Accept" icon= "sap-icon://complete"
						press=".onPressButtonFinCharg"
						enabled="{= (%{chargementModelJson>/results/3/nbUmTotalFaucam} > 0) || (%{chargementModelJson>/results/3/tChargItem}.length === 0)?false:true}"
			 			ariaDescribedBy="defaultButtonDescription genericButtonDescription">
					<layoutData>
						<FlexItemData growFactor="1" />
					</layoutData>
				</Button>

	<MessageStrip id = "messageStripInformationV2"
				text="{notificationsQuaisModel>/quais/3/notifs/notifsuccess/msg_txt}"
				type="Success"
				showIcon="true"
				visible = "{notificationsQuaisModel>/quais/3/notifs/notifsuccess/visible}"
				class="sapUiNoMarginBottom sapUiNoMarginBegin">
			</MessageStrip>
  
  <MessageStrip id = "messageStripWarningV2"
				text="{notificationsQuaisModel>/quais/3/notifs/notifwarning/msg_txt}"
				type="Warning"
				showIcon="true"
				visible = "{notificationsQuaisModel>/quais/3/notifs/notifwarning/visible}"
				class="sapUiNoMarginBottom">
			</MessageStrip>
		
			  <MessageStrip id = "messageStripErrorV2"
				text="{notificationsQuaisModel>/quais/3/notifs/notiferror/msg_txt}"
				type="Error"
				showIcon="true"
				visible = "{notificationsQuaisModel>/quais/3/notifs/notiferror/visible}"
				class="sapUiNoMarginBottom">
			</MessageStrip>


		
    </mvc:View>

