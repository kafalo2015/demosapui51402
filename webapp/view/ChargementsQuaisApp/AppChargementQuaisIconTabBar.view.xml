<mvc:View controllerName="clf.logistique.chargementquais.controller.ChargementsQuaisApp.AppChargementQuaisIconTabBar"
displayBlock="true"
xmlns:mvc="sap.ui.core.mvc"
xmlns="sap.m"
height = "100%">
	<IconTabBar
		id="idIconTabBarQuais"
		expandable = "false"
		select=".onTabSelect"
		class="sapUiResponsiveContentPadding"
		items = "{chargementModelJson>/results}"  >
		<items>
			<IconTabFilter
				icon="sap-icon://inventory"
				iconColor="{=%{chargementModelJson>chargementEncours} === true ? 'Positive': 'Negative' }"
				count="{chargementModelJson>numtransport}"
				text="{chargementModelJson>quai}"
				design = 'Horizontal'
				key="{chargementModelJson>quai}"/>
		</items>
		<content >  
	             <!-- Le quai sera chargé pr routing  -->
		</content>
	</IconTabBar>
	<ScrollContainer vertical='true'>
	     
	 <Panel  headerText ="Messages" id = "PanelMessageAppChargementQuais" stickyHeader="true" height="120px" >
			<content>

				<List   headerText="" mode="" items="{ path : 'notificationsQuaisModel>/notif_txt_all',
				                                       sorter: { path: 'time', descending: true    }}"
						growing="false"
						growingThreshold="1"
						growingScrollToLoad="false">
					<CustomListItem>
						<MessageStrip 
							text="{notificationsQuaisModel>msg_txt}"
							type="{notificationsQuaisModel>type_msg}"
							showIcon="true"
							visible = "true"
							class="sapUiNoMarginBottom sapUiNoMarginBegin">
						</MessageStrip>
						
					</CustomListItem>
	            </List>
			</content>
		</Panel>

	</ScrollContainer>
</mvc:View>






