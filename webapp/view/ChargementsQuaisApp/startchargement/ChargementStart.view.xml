							  <Input
							id="MatriculeTabular"
							value=   "{ChargementStartModel>/results/matri}" 
							textFormatMode="ValueKey"
							placeholder="Saisir le matricule..."
							showSuggestion="true"
							showTableSuggestionValueHelp="false"
							suggestionRows="{ChargementStartModel>/results/tSuggestedMatricule}"
							suggestionItemSelected=".onSuggestionItemSelected">
						<suggestionColumns>
							<Column
								popinDisplay="Inline"
								demandPopin="true">
								<Label text="Matricule" />
							</Column>
							<Column
								popinDisplay="Inline"
								demandPopin="true">
								<Label text="Nom" />
							</Column>

							

							
						</suggestionColumns>

						<suggestionRows>
							<ColumnListItem>
								<Label text="{ChargementStartModel>zpcfMatri}" />
								<Label text="{ChargementStartModel>zpcfName1}" />
							    
						     </ColumnListItem>
			           </suggestionRows>
			      </Input>
 <Label id= "LabelTransport" class="sapUiTinyMarginEnd" text="TRANSPORT"  design="Bold" />
							  <Input
							id="TknumInputTabular"
							value="{ChargementStartModel>/results/tknum}" 
							textFormatMode="ValueKey"
							placeholder="Saisir le numéro de transport "
							showSuggestion="true"
							showTableSuggestionValueHelp="false"
							suggestionRows="{ChargementStartModel>/results/tSuggestedTknum}"
							suggestionItemSelected=".onSuggestionItemSelected">
						<suggestionColumns>
							<Column
								popinDisplay="Inline"
								demandPopin="true">
								<Label text="Transport" />
							</Column>
							<Column
								popinDisplay="Inline"
								demandPopin="true">
