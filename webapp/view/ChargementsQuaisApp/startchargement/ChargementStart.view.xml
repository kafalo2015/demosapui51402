				             <core:Item text="{ChargementStartModel>tknum}" />
							 </suggestionItems>
							
							  </Input> -->


							   <!-- GEMINI [Amélioration performances] Limiter le nombre de suggestionRows à  100 au lieu de 800 -->
							  <Input
							id="MatriculeTabularInput"
							value=   "{ChargementStartModel>/results/matri}" 
							valueState=""
							textFormatMode="ValueKey"
							placeholder="Saisir le matricule..."
							showSuggestion="true"
							showTableSuggestionValueHelp="false"
							suggestionRows="{path: 'ChargementStartModel>/results/tSuggestedMatricule', length: 400}"   
							suggestionItemSelected=".onSuggestionItemSelected"
							submit=".onSubmit">
							<formattedValueStateText>
							<FormattedText htmlText="Veuillez saisir un numéro de matricule">
								<controls>
									<Link
										text="See more information"
										href=""
										press=".onFormattedTextLinkPress" />
								</controls>
							</FormattedText>
						</formattedValueStateText>	
							


						<suggestionColumns>
							<Column
								popinDisplay="Inline"
								demandPopin="true">
								<Label text="Matricule" />
							</Column>
							<Column
								popinDisplay="Inline"
								demandPopin="true">
								<Label text="Nom" />
							</Column>

							

							
						</suggestionColumns>

						<suggestionRows>
							<ColumnListItem>
								<Label text="{ChargementStartModel>zpcfMatri}" />
