				</FlexBox> 
				 	
			</l:BlockLayoutCell>
</l:BlockLayoutRow>
<l:BlockLayoutRow>
	<l:BlockLayoutCell  backgroundColorSet="ColorSet1"
			   backgroundColorShade="ShadeA">
		      <MessageStrip id = "ChargementStartmessageStripError"
				text="{notificationsQuaisModel>/chargementstartnotifs/notiferror/msg_txt}"
				type="Error"
				showIcon="true"
				visible = "{notificationsQuaisModel>/chargementstartnotifs/notiferror/visible}"
				class="sapUiNoMarginBottom">
			</MessageStrip>
           <MessageStrip id = "ChargementStartmessageStripWarning"
				text="{notificationsQuaisModel>/chargementstartnotifs/notifwarning/msg_txt}"
				type="Warning"
				showIcon="true"
				visible = "{notificationsQuaisModel>/chargementstartnotifs/notifwarning/visible}"
				class="sapUiNoMarginBottom">
			</MessageStrip>
		
			<!--  NE PAS METTRE MESSAGE STRIP SUCCESS cela ne sert à rien
			 <MessageStrip id = "ChargementStartmessageStripInformation"
				text="{notificationsQuaisModel>/chargementstartnotifs/notifsuccess/msg_txt}"
				type="Success"
				showIcon="true"
				visible = "{notificationsQuaisModel>/chargementstartnotifs/notifsuccess/visible}"
				class="sapUiNoMarginBottom sapUiNoMarginBegin">
			</MessageStrip>-->
				</l:BlockLayoutCell>
			
