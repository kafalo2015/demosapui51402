								demandPopin="true">
								<Label text="Date Transport planifié" />
							</Column>

							<Column
								popinDisplay="Inline"
								demandPopin="true">
								<Label text="Heure Transport planifié" />
							</Column>
						</suggestionColumns>

						<suggestionRows>
							<ColumnListItem>
								<Label text="{ChargementStartModel>tknum}" />
								<Label text="{ChargementStartModel>dplbg}" />
							    <Label text="{ChargementStartModel>uplbg}" />
							    <Label text="{ChargementStartModel>dptbg}" />
								<Label text="{ChargementStartModel>uptbg}" />
						     </ColumnListItem>
			           </suggestionRows>
			      </Input>
						 <Button id="Btn_Start_Chargement" text="DEMARRER CHARGEMENT" press="onClickChargementQuai"/>
