<mvc:View controllerName="clf.logistique.chargementquais.controller.main.MainSideNavigation"
    displayBlock="false"	
	height="100%"
    xmlns:mvc="sap.ui.core.mvc"
	xmlns:tnt="sap.tnt"
    xmlns="sap.m">
<HBox  height="100%">
	<VBox renderType="Bare" alignItems="Start" height="100%"  >
		<Button
		    id = "MainSideNavigationCollapseExpandeBtn"
			tooltip ="Agrandir/Rétrécir" 
			text=""
			icon="sap-icon://menu2"
			press=".onCollapseExpandPress" />
		<tnt:SideNavigation id="sideNavigation" selectedKey="walked" expanded="true" itemSelect= "itemSelect" >
			<tnt:NavigationList>
					<tnt:NavigationListItem text="{i18n>SuiviCharg}" icon="sap-icon://activity-items" key ="item_chargement_list" />
					<tnt:NavigationListItem text="{i18n>ChargQuais}" icon="sap-icon://inventory" key ="item_quai_all" />
			</tnt:NavigationList>

			<tnt:fixedItem>
				<tnt:NavigationList>
					<tnt:NavigationListItem text="Statistiques" icon="sap-icon://bar-chart" />
					<tnt:NavigationListItem  href="https://sap.com" target="_blank" text="Liens externes" icon="sap-icon://attachment" />
					<tnt:NavigationListItem  text="Comparaison" icon="ccompare" />
				</tnt:NavigationList>
			</tnt:fixedItem>
		</tnt:SideNavigation>
	</VBox>
	
   		<NavContainer	id="navcontainermain"
						width="1200px"
						height="1200px"
						class="navContainerControl sapUiSmallMarginBottom">
						<pages>
						</pages>
		</NavContainer>	
		
</HBox>
</mvc:View>