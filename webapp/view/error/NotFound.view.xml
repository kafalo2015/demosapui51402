<mvc:View controllerName="clf.logistique.chargementquais.controller.error.NotFound"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">
        <Page 
            showNavButton="true" 
            navButtonPress=".onNavBack">
            <IllustratedMessage 
                illustrationType="sapIllu-PageNotFound"
                title="{i18n>notFoundTitle}"
                description="{i18n>notFoundDescription}">
                <additionalContent>
                    <!-- Tu peux ajouter un bouton d'action ici si nécessaire -->
                </additionalContent>
            </IllustratedMessage>
        </Page>

    </mvc:View>
